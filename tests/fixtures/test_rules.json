    "Glob": { "if": "readable", "then": "allow", "else": "deny" },
    "Grep": { "if": "readable", "then": "allow", "else": "deny" },
    "LSP": "allow",
    "Agent": "allow",
    "Skill": "allow",
    "TaskCreate": "allow",
    "TaskGet": "allow",
    "TaskList": "allow",
    "TaskUpdate": "allow",
    "TaskStop": "allow",
    "ToolSearch": "allow",
    "ListMcpResourcesTool": "allow",
    "ReadMcpResourceTool": "allow",
    "WebFetch": "allow",
    "WebSearch": "allow",
    "AskUserQuestion": "allow",
    "EnterPlanMode": "allow",
    "ExitPlanMode": "allow"
  },
  "fileAccess": {
    "read": {
      "globPatterns": [
        "**",
        "!**/*.env*",
        "!**/*.key*",
        "!**/*.pem*",
        "!**/*credentials*",
        "!**/*id_ed25519*",
        "!**/*id_rsa*",
        "!**/*secret*"
      ]
    },
    "write": {
      "globPatterns": ["/tmp/**", "/workspace/**"],
      "requireReadable": true
    }
  }
}
